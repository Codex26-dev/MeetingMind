# Optional live assistant. Keep .env private and never commit real secrets.
# OpenAI Responses API: AI_PROVIDER=openai and set OPENAI_API_KEY.
AI_PROVIDER=openai
AI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# Or connect a locally running Ollama server:
# AI_PROVIDER=ollama
# AI_MODEL=qwen2.5:7b
# OLLAMA_URL=http://127.0.0.1:11434

HOST=127.0.0.1
PORT=4173
