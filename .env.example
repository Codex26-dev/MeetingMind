# Optional live assistant. Keep .env private and never commit real secrets.
# OpenAI Responses API: AI_PROVIDER=openai and set OPENAI_API_KEY.
AI_PROVIDER=openai
AI_MODEL=gpt-4.1-mini
# Optional OpenAI Realtime model for natural, two-way live voice.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_API_KEY=
# Required to authorize browser requests to the AI server. Use a long random value.
# Configure the same value in Workspace admin → AI assistant connection.
APP_ACCESS_TOKEN=
# Allow the assistant to use Responses API web search for explicitly requested/current-information queries.
WEB_SEARCH_ENABLED=true

# Set this on your hosted AI server to the app origins that may call it.
CORS_ORIGINS=http://localhost:4173,http://localhost:5173,https://codex26-dev.github.io

# Or connect a locally running Ollama server:
# AI_PROVIDER=ollama
# AI_MODEL=qwen2.5:7b
# OLLAMA_URL=http://127.0.0.1:11434

HOST=127.0.0.1
PORT=4173
